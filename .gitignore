# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
.env.local

# vercel
.vercel

# cloudflare local dev env vars (never commit)
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts

# Sensitive credentials and secrets
auth0-clientid.json
*-clientid.json
*-credentials.json
*.key
*.secret

# ADK Backend Python files
adk-backend/__pycache__/
adk-backend/*.py[cod]
adk-backend/venv/
adk-backend/.env
adk-backend/.env.local
adk-backend/*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
